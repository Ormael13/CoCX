package classes.Scenes.Areas.GlacialRift
{
import classes.*;
import classes.BodyParts.Butt;
import classes.BodyParts.Hips;
import classes.BodyParts.LowerBody;
import classes.BodyParts.Skin;
import classes.Scenes.Combat.Combat;
import classes.Scenes.SceneLib;
import classes.internals.WeightedDrop;

import coc.view.ButtonData;

public class FrostWyrm extends Monster
	{
		private function FrostWyrmIceBreath():void {
			outputText("The wyrm inhales before unleashing a cone of ice at you. ");
			var breathdmg:Number = (eBaseIntelligenceDamage() * 10);
			breathdmg += (eBaseWisdomDamage() * 10);
			player.takeIceDamage(breathdmg, true);
			outputText(" damage! ");
			if (!player.hasPerk(PerkLib.ColdAffinity)) {
				outputText(" You are frozen solid by the attack! ");
				if (player.hasStatusEffect(StatusEffects.FrozenSolid)) {
					if (player.hasPerk(PerkLib.FireAffinity)) player.addStatusValue(StatusEffects.FrozenSolid, 1, 2);
					else player.addStatusValue(StatusEffects.FrozenSolid, 1, 1);
				}
				else {
					if (player.hasPerk(PerkLib.FireAffinity)) player.createStatusEffect(StatusEffects.FrozenSolid, 4, 0, 0, 0);
					else player.createStatusEffect(StatusEffects.FrozenSolid, 2, 0, 0, 0);
				}
			}
		}
		
		private function FrostWyrmTremor():void {
			outputText("The frost wyrm is currently tunneling beneath the ice. The tremors generated by the wyrm’s tunneling causes you to lose balance and fall flat on your back as rocks and ice flies around hiting you. ");
			var tremordmg:Number = (this.str + this.spe + this.tou) * 10;
			player.takeIceDamage(tremordmg, true);
			player.createStatusEffect(StatusEffects.Stunned, 1, 0, 0, 0);
		}
		
		private function FrostWyrmWait():void {
			outputText("The frost wyrm is currently tunneling beneath the ice.");
			player.addStatusValue(StatusEffects.MonsterDig, 1, -1);
		}
		
		private function FrostWyrmDig():void {
			outputText("The frost wyrm plunges back into the ground, avoiding further attacks for now as it prepares to surge again.");
			if (!player.hasStatusEffect(StatusEffects.MonsterDig)) player.createStatusEffect(StatusEffects.MonsterDig, 1 + rand(6), 0, 0, 0);
			if (!player.hasStatusEffect(StatusEffects.MonsterInvisible)) player.createStatusEffect(StatusEffects.MonsterInvisible, 0, 0, 0, 0);
		}
		
		private function FrostWyrmGrab():void {
			outputText("The frost wyrm surges out of the ice beneath your feet, opening her arms wide in an attempt to catch you. ");
			if (Combat.playerWaitsOrDefends()){
				outputText("You dodge at the last moment causing the disappointed giantess to land flat next to you, it's time to strike back!\n\n");
			} else {
				outputText("The wyrm aims well and seizes you with her claws. She begins hugging you cheerfully as her massive tail wraps around you. You need to get free before the over enthusiastic dimwit giantess accidentally crushes you with her coil.\n\n");
				player.createStatusEffect(StatusEffects.Constricted, 2 + rand(5), 0, 0, 0);
			}
			player.removeStatusEffect(StatusEffects.MonsterDig);
			player.removeStatusEffect(StatusEffects.MonsterInvisible);
			createStatusEffect(StatusEffects.AbilityCooldown1, 2, 0, 0, 0);
		}
		
		private function FrostWyrmConstrict():void {
			var damage:Number = rand(weaponAttack);
			outputText("The dopey wyrm keeps on squeezing you amorously. ");
			damage += eBaseStrengthDamage() * 2;
			damage = Math.round(damage);
			player.takePhysDamage(damage, true);
			outputText(" damage. ");
			statScreenRefresh();
		}
		
		public function frostWyrmGrabStruggle():void {
			clearOutput();
			if ((player.statusEffectv1(StatusEffects.Constricted) - 1 <= 0) || player.hasPerk(PerkLib.FluidBody)) {
				outputText("You finally manage to escape the dragon’s affectionate death grip, to her absolute disappointment.");
				player.removeStatusEffect(StatusEffects.Constricted);
				//return;
			} else {
				outputText("No matter how hard you try you can't seem to escape the wyrm coils!");
				player.addStatusValue(StatusEffects.Constricted, 1, -1);
			}
			outputText("\n\n");
			SceneLib.combat.enemyAIImpl();
		}
		public function frostWyrmGrabWait():void {
			clearOutput();
			outputText("Why bother resisting? Theres no way you can escape this anyway.\n\n");
			SceneLib.combat.enemyAIImpl();
		}
		
		override public function changeBtnWhenBound(btnStruggle:ButtonData, btnBoundWait:ButtonData):void{
			if (player.hasStatusEffect(StatusEffects.Constricted)) {
				btnStruggle.call(frostWyrmGrabStruggle);
				btnBoundWait.call(frostWyrmGrabWait);
			}
		}
		
		override protected function performCombatAction():void {
			if (player.hasStatusEffect(StatusEffects.MonsterDig)) {
				if (player.statusEffectv1(StatusEffects.MonsterDig) > 0) {
					if (!player.isFlying() && rand(3) == 0) FrostWyrmTremor();
					else FrostWyrmWait();
				}
				else if (player.statusEffectv1(StatusEffects.MonsterDig) == 0) {
					FrostWyrmGrab();
				}
			} else if (player.hasStatusEffect(StatusEffects.Constricted)) {
				FrostWyrmConstrict();
			} else {
				var choice:Number = rand(3);
				if (choice == 0) {
					if (!hasStatusEffect(StatusEffects.AbilityCooldown1)) FrostWyrmDig();
					else FrostWyrmIceBreath();
				}
				if (choice > 0) FrostWyrmIceBreath();
			}
		}
		
		override public function defeated(hpVictory:Boolean):void
		{
			SceneLib.glacialRift.frostWyrmScene.winAgainstFrostWyrm();
		}
		
		override public function won(hpVictory:Boolean, pcCameWorms:Boolean):void
		{
			SceneLib.glacialRift.frostWyrmScene.loseToFrostWyrm();
		}
		
		override public function get long():String
		{
			var str:String = "";
			str += "You are currently fighting a frost wyrm, a somewhat dim witted subspecies of true dragons. While unable to fly the wyrm can dig underground through ice and solid rock at ridiculous speed using its powerful claw and gigantic frame easily 60 feet long. ";
			str += "This one is clearly looking for a mate to alleviate its needs and you came along at the worst of times hence why you are now fighting it though if you really wanted you could just let the overly affectionate reptile have her way with you.";
			if (player.hasStatusEffect(StatusEffects.MonsterDig)) str += "\n\n<b>The wyrm currently lurks beneath the ice preparing to ambush you from below.</b>";
			return str;
		}
		
		public function FrostWyrm() 
		{
			this.a = "a ";
			this.short = "frost wyrm";
			//this.imageName = "yuki-onna";
			this.long = "";
			this.createVagina(false, 1, 1);
			createBreastRow(Appearance.breastCupInverse("J"));
			this.ass.analLooseness = AssClass.LOOSENESS_NORMAL;
			this.ass.analWetness = AssClass.WETNESS_NORMAL;
			this.tallness = 55*12;
			this.hips.type = Hips.RATING_AMPLE;
			this.butt.type = Butt.RATING_LARGE;
			this.lowerBody = LowerBody.FROSTWYRM;
			this.skin.growCoat(Skin.SCALES,{color:"black"});
			this.hairColor = "white";
			this.hairLength = 15;
			initStrTouSpeInte(1205, 890, 620, 38);
			initWisLibSensCor(560, 880, 130, -20);
			this.weaponName = "claws";
			this.weaponVerb="claw-slash";
			this.weaponAttack = 610;
			this.armorName = "scales";
			this.armorDef = 2000;
			this.armorMDef = 100;
			this.bonusHP = 2500;
			this.bonusLust = 1110;
			this.lust = 25 + rand(15);
			this.lustVuln = 0.6;
			this.level = 100;
			this.gems = 150 + rand(20);
			this.drop = new WeightedDrop()
					.add(consumables.F_TEAR, 1);
			this.createPerk(PerkLib.TankI, 0, 0, 0, 0);
			this.createPerk(PerkLib.GoliathI, 0, 0, 0, 0);
			this.createPerk(PerkLib.CheetahI, 0, 0, 0, 0);
			this.createPerk(PerkLib.RefinedBodyI, 0, 0, 0, 0);
			this.createPerk(PerkLib.EnemyBeastOrAnimalMorphType, 0, 0, 0, 0);
			this.createPerk(PerkLib.EnemyColossalType, 0, 0, 0, 0);
			this.createPerk(PerkLib.EnemyBossType, 0, 0, 0, 0);
			checkMonster();
		}
		
	}

}
